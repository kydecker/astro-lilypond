{
	"name": "astro-lilypond",
	"version": "1.1.1",
	"description": "An Astro integration for rendering Lilypond markup to music notation.",
	"homepage": "https://lilypond.ky.fyi",
	"author": "Ky Decker",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/kydecker/astro-lilypond"
	},
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./loader": {
			"types": "./dist/loader.d.ts",
			"import": "./dist/loader.js"
		}
	},
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"build": "tsc --project tsconfig.build.json",
		"test": "vitest",
		"test:coverage": "vitest run --coverage"
	},
	"keywords": [
		"astro",
		"astro-integration",
		"astro-loader",
		"engraving",
		"image",
		"images",
		"lilypond",
		"markdown",
		"media",
		"music",
		"renderer",
		"score",
		"tooling",
		"withastro",
		"utils"
	],
	"peerDependencies": {
		"astro": ">=7.0.0"
	},
	"dependencies": {
		"astro-emit-asset": "^0.1.4",
		"unist-util-visit": "^5.1.0"
	},
	"devDependencies": {
		"@astrojs/markdown-remark": "^7.2.2",
		"@astrojs/markdown-satteri": "^0.3.5",
		"@types/mdast": "^4.0.4",
		"@types/node": "^26.1.1",
		"@vitest/coverage-v8": "^4.1.10",
		"astro": "^7.1.6",
		"satteri": "^0.9.5",
		"typescript": "^7.0.2",
		"unified": "^11.0.5",
		"vite": "^8.0.0",
		"vitest": "^4.1.10"
	}
}

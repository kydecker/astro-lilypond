---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import { render } from "astro-lilypond";
import emptyScore from "#examples/empty.ly";

const { Score } = await render(emptyScore, { crop: true });
---

<StarlightPage
  frontmatter={{
    title: "4′33″: Page Not Found",
    description: "We couldn't find that page.",
  }}
>
  <Score class="empty" />
</StarlightPage>

<style>
  .empty {
    width: 100%;
  }
</style>

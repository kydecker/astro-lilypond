---
import type {
	SidebarEntry,
	SidebarLink,
} from "@astrojs/starlight/utils/routing/types";

function flattenLinks(entries: SidebarEntry[]): SidebarLink[] {
	return entries.flatMap((entry) =>
		entry.type === "link" ? entry : flattenLinks(entry.entries),
	);
}

const docsSections = Astro.locals.starlightRoute.sidebar
	.filter((entry) => entry.type === "group")
	.map((group) => ({ label: group.label, links: flattenLinks(group.entries) }));
---

<div class="docs-toc not-content">
  {docsSections.map((docsSection) => (
    <div class="docs-toc-column">
      <h3>{docsSection.label}</h3>
      <ul>
        {docsSection.links.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </div>
  ))}
</div>

<style>
  .docs-toc {
    display: grid;
    gap: 2rem;

    @media (width > 560px) {
      grid-template-columns: repeat(2, 1fr);
    }

    @media (width > 700px) {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .docs-toc-column h3 {
    font-size: var(--sl-text-base);
    margin-block-end: 0.75rem;
  }

  .docs-toc-column ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    line-height: 1.2;
  }

  .docs-toc-column a {
    color: var(--sl-color-gray-2);
    text-decoration: none;
  }

  .docs-toc-column a:hover {
    color: var(--sl-color-white);
    text-decoration: underline;
  }
</style>

---
import { Code } from "@astrojs/starlight/components";
import type { AstroComponentFactory } from "astro-lilypond";

interface Props {
	Score: AstroComponentFactory;
	code: string;
	/** `<Code>` frame title, e.g. the source filename. */
	title: string;
	summary?: string;
}

const { Score, code, title, summary = "View source" } = Astro.props;
---

<Score class="example" />

<details>
  <summary>{summary}</summary>
  <Code code={code} lang="lilypondtext" title={title} class="example-code" />
</details>

<style>
  .example {
    width: 100%;
  }

  .example-code :global(.frame pre) {
    max-height: min(68vh, 600px);
    overflow: auto;
  }
</style>

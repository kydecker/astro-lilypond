---
import { Code } from "@astrojs/starlight/components";
import type { GetScoreResult } from "astro-lilypond";

interface Props extends Pick<GetScoreResult, "Score" | "raw"> {
	/** `<Code>` frame title, e.g. the source filename. */
	title: string;
	summary?: string;
}

const { Score, raw, title, summary = "View source" } = Astro.props;
---

<Score class="example" />

<details>
  <summary>{summary}</summary>
  <Code code={raw} lang="lilypondtext" title={title} class="example-code" />
</details>

<style>
  .example {
    width: 100%;
  }

  .example-code :global(.frame pre) {
    max-height: min(68vh, 600px);
    overflow: auto;
  }
</style>

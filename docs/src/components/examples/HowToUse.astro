---
import { Code } from "@astrojs/starlight/components";
import { Score } from "astro-lilypond";
import FencedLilyPond from "#components/FencedLilypond.astro";
import score from "./scores/example.ly";
import exampleRaw from "./scores/example.ly?raw";
---

<section>
  <div>
    <p>
      Write <a href="https://lilypond.org">LilyPond</a> inside Markdown&hellip;
    </p>
    <FencedLilyPond code={exampleRaw} title="example.md" />
  </div>
  <div class="result">
    <div>
      <p>&hellip;and it renders as music notation.</p>
      <Score content={score} crop class="responsive" />
    </div>
    <div class="quick-start not-content">
      <Code lang="sh" code="pnpm astro add astro-lilypond" title="Quick start" />
    </div>
  </div>
</section>

<style>
  section {
    padding-block: 0.5em;
    display: grid;
    width: 100%;
    max-width: 340px;
    flex-direction: row;
    gap: 1.5rem;
    text-align: left;

    @media (width > 620px) {
      max-width: 100%;
      grid-template-columns: 1fr 1fr;
    }
  }

  p {
    font-size: var(--sl-text-lg);
    font-style: italic;
  }

  .result {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    margin: 0;

    p {
      text-align: right;
    }

    .expressive-code {
      margin-block-start: 1rem;
    }
  }

  .responsive {
    width: 100%;
  }
</style>

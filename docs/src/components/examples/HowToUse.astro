---
import { Score } from "astro-lilypond";
import FencedLilyPond from "#components/FencedLilypond.astro";
import score from "./scores/example.ly";
import exampleRaw from "./scores/example.ly?raw";
---

<section>
  <div>
    <p>
      Write <a href="https://lilypond.org">LilyPond</a> inside Markdown&hellip;
    </p>
    <FencedLilyPond code={exampleRaw} title="example.md" />
  </div>
  <div>
    <p>&hellip;and it renders as music notation.</p>
    <Score content={score} crop class="responsive" />
  </div>
</section>

<style>
  section {
    padding-block: 0.5em;
    display: grid;
    width: 100%;
    max-width: 340px;
    flex-direction: row;
    gap: 1.5rem;
    text-align: left;

    > div {
      margin: 0;

      &:last-child p {
        text-align: right;
      }
    }

    @media (width > 620px) {
      max-width: 680px;
      grid-template-columns: 1fr 1fr;
    }
  }

  p {
    font-size: var(--sl-text-lg);
    font-style: italic;
  }

  .responsive {
    width: min(400px, 100%);
  }
</style>

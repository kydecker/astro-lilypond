---
import { render } from "astro-lilypond";
import rainbowRoad from "./scores/rainbow-road.ly";

const { Score } = await render(rainbowRoad, { crop: true });
---

<Score class="styled" />

<style>
  @keyframes rainbow {
    from { filter: hue-rotate(0deg); }
    to { filter: hue-rotate(360deg); }
  }

  .styled {
    animation: rainbow 3s infinite;
    background-color: peachPuff;
    padding: 6px;
  }
</style>

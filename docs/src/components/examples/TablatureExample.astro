---
import { render } from "astro-lilypond";
import LilyPondExample from "#components/LilyPondExample.astro";
import score from "./scores/tab-example.ly";
import code from "./scores/tab-example.ly?raw";

const { Score } = await render(score, { crop: true });
---

<LilyPondExample Score={Score} code={code} title="tab-example.ly" />
